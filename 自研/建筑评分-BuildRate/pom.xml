<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.nangua.buildrate</groupId>
  <artifactId>buildrate</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>cn.dreeam.leaf</groupId><artifactId>leaf-api</artifactId><version>26.3.build.13-alpha</version><scope>provided</scope>
      <systemPath>${project.basedir}/../lib/leaf-api-26.3.build.13-alpha.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>3.53.4.0</version><scope>provided</scope>
    </dependency>
      <!-- 软依赖：PumpkinMail（RewardDispatcher 调用 PumpkinMail.get()/Reward）。构建前先构建同目录 PumpkinMail -->
    <dependency>
      <groupId>com.nangua</groupId>
      <artifactId>PumpkinMail</artifactId>
      <version>1.0.0</version>
      <scope>provided</scope>
      <systemPath>${project.basedir}/../lib/PumpkinMail.jar</systemPath>
    </dependency>
    <!-- 传递依赖：systemPath 引入的 leaf-api 不带传递依赖，显式声明（provided，运行时服务端提供） -->
    <dependency>
      <groupId>net.kyori</groupId>
      <artifactId>adventure-api</artifactId>
      <version>5.2.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains</groupId>
      <artifactId>annotations</artifactId>
      <version>23.0.0</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <resources><resource><directory>src/main/resources</directory><filtering>false</filtering></resource></resources>
  </build>
</project>
