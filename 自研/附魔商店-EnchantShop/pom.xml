<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nangua.enchshop</groupId>
    <artifactId>EnchantShop</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>EnchantShop</name>
    <description>附魔商店：读取 ExcellentEnchants 配置，玩家用经验等级购买/升级附魔</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Leaf 26.3 API（共享 lib，本地 systemPath） -->
        <dependency>
            <groupId>cn.dreeam.leaf</groupId>
            <artifactId>leaf-api</artifactId>
            <version>26.3.build.13-alpha</version>
            <scope>provided</scope>
            <systemPath>${project.basedir}/../lib/leaf-api-26.3.build.13-alpha.jar</systemPath>
        </dependency>

        <!--
          运行期依赖 ExcellentEnchants（plugin.yml 中 depend）。
          该插件仅以 Bukkit API 读取 ExcellentEnchants 的磁盘配置文件，
          编译期不需其 API，故此处不引入编译依赖。
          如需在编译期校验（例如改用其 API），请启用下方依赖并替换为 26.3 兼容版本：
        -->
        <!--
        <dependency>
            <groupId>...</groupId>
            <artifactId>ExcellentEnchants</artifactId>
            <version>...</version>
            <scope>provided</scope>
        </dependency>
        -->
        <!-- 传递依赖：systemPath 引入的 leaf-api 不带传递依赖，显式声明（provided，运行时服务端提供） -->
    <dependency>
      <groupId>net.kyori</groupId>
      <artifactId>adventure-api</artifactId>
      <version>5.2.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains</groupId>
      <artifactId>annotations</artifactId>
      <version>23.0.0</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
        </plugins>
    </build>
</project>
