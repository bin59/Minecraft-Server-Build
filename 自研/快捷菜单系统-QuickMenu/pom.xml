<?xml version="1.0" encoding="UTF-8"?>
<!--
  QuickMenu 插件 Maven 构建配置

  本文件为可选。本机若无 Maven，可直接使用 target/ 下已编译的 jar。
  提供本文件的目的是：让你在 IntelliJ IDEA / Eclipse 中导入工程，
  获得代码补全与即时编译错误提示。

  依赖说明：
   - leaf-api 26.3.build.13-alpha：服务端 API（systemPath 引用 自研/lib/）
   - Geyser-Spigot / floodgate-api / Residence：外置软依赖，运行时由服务器提供
     systemPath 指向本机实跑 jar；version 仅为占位标识，实际以 jar 为准。
     若路径变化，改下方 systemPath 即可。

  编译目标：Java 21（maven.compiler.release=21）。
  产物位置：target/QuickMenu-1.0.0.jar
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nangua</groupId>
    <artifactId>QuickMenu</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>QuickMenu</name>
    <description>双轨快捷菜单 - Java 玩家箱子 GUI，基岩玩家原生 Form 表单</description>

    <properties>
        <!-- 编译产物为 Java 21 字节码，可由 Java 21+ 运行时加载 -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!--
          全部使用 provided 语义：
          这些依赖在运行时由服务器核心（Leaf）与已安装的
          Floodgate / Residence 插件提供，绝不能打进插件 jar，否则会类冲突。
        -->

        <!-- 服务端 API：Leaf 26.3 -->
        <dependency>
            <groupId>cn.dreeam.leaf</groupId>
            <artifactId>leaf-api</artifactId>
            <version>26.3.build.13-alpha</version>
            <scope>provided</scope>
            <systemPath>${project.basedir}/../lib/leaf-api-26.3.build.13-alpha.jar</systemPath>
        </dependency>

        <!--
          Geyser-Spigot：提供 cumulus 原生表单 API（org.geysermc.cumulus.*）。
          systemPath 指向本机实跑 jar，version 仅为占位标识。
        -->
        <dependency>
            <groupId>org.geysermc</groupId>
            <artifactId>Geyser-Spigot</artifactId>
            <version>26.3</version>
            <scope>provided</scope>
            <systemPath>F:/game/pc/MC/开服/所需文件/互通服/Geyser互通端/Geyser-Spigot.jar</systemPath>
        </dependency>

        <!--
          Floodgate API：提供 isFloodgatePlayer / sendForm 等能力（org.geysermc.floodgate.api.*）。
          systemPath 指向本机实跑 jar，version 仅为占位标识。
        -->
        <dependency>
            <groupId>org.geysermc.floodgate</groupId>
            <artifactId>api</artifactId>
            <version>26.3</version>
            <scope>provided</scope>
            <systemPath>${project.basedir}/../lib/floodgate-api.jar</systemPath>
        </dependency>

        <!--
          Residence：领地系统（软依赖，插件用反射调用，未装时不生效）。
          systemPath 指向本机实跑 jar，version 仅为占位标识。
        -->
        <dependency>
            <groupId>com.bekvon.bukkit.residence</groupId>
            <artifactId>Residence</artifactId>
            <version>26.3</version>
            <scope>provided</scope>
            <systemPath>${project.basedir}/../lib/Residence.jar</systemPath>
        </dependency>

        <!-- 仅用于消除 leaf-api 中 @Contract 等注解的编译警告 -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- 传递依赖：systemPath 引入的 leaf-api 不带传递依赖，显式声明（provided，运行时服务端提供） -->
    <dependency>
      <groupId>net.kyori</groupId>
      <artifactId>adventure-api</artifactId>
      <version>5.2.0</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

    <build>
        <!-- 产物固定命名，便于部署脚本引用 -->
        <finalName>${project.artifactId}-${project.version}</finalName>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>plugin.yml</include>
                    <include>config.yml</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <!-- 开启全部 lint 检查，serial 噪音除外 -->
                        <arg>-Xlint:all,-serial,-deprecation</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
