<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mc</groupId>
    <artifactId>spaceportal</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>SpacePortal</name>
    <description>空间传送阵：Java/基岩（Geyser）互通服两点传送插件，带大型粒子阵法与时光穿梭特效</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Leaf 26.3 API（共享 lib，本地 systemPath） -->
        <dependency>
            <groupId>cn.dreeam.leaf</groupId>
            <artifactId>leaf-api</artifactId>
            <version>26.3.build.13-alpha</version>
            <scope>provided</scope>
            <systemPath>${project.basedir}/../lib/leaf-api-26.3.build.13-alpha.jar</systemPath>
        </dependency>

        <!--
          Adventure API：Leaf 26.3 内置 Adventure 5.x（消息/动作栏 Component 来自此库）。
          由于上面的 leaf-api 以 systemPath 引入，Maven 不会自动解析其传递依赖，
          因此这里需显式声明 adventure-api（provided，运行时由服务端提供）。
          下方示例仅说明写法；实际生效的是紧随其后显式声明的 adventure-api 依赖。
        -->
        <!--
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>5.0.0</version>
            <scope>provided</scope>
        </dependency>
        -->
        <!-- 传递依赖：systemPath 引入的 leaf-api 不带传递依赖，显式声明（provided，运行时服务端提供） -->
    <dependency>
      <groupId>net.kyori</groupId>
      <artifactId>adventure-api</artifactId>
      <version>5.2.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains</groupId>
      <artifactId>annotations</artifactId>
      <version>23.0.0</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

    <build>
        <finalName>SpacePortal-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
        </plugins>
    </build>
</project>
