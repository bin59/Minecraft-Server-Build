                    elseif ($pendingSwitchMode -eq 'whatif') { $whatIf = $true }
                    elseif ($pendingSwitchMode -eq 'confirm') { $confirm = $true }
                    $pendingSwitchMode = $null
                    continue
                }
                if ($arg -match '^(?i)(\$?false|0)$') {
